[Unit]
Description=palace-daemon — mempalace HTTP/MCP gateway (system unit)
Documentation=https://github.com/techempower-org/palace-daemon
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# A daemon that fails to start (or is aborted by the watchdog) 5 times in 70 min stops restarting and shows
# failed, instead of a restart storm (review #345 r1); RestartSec=10 spaces the tries. Review r3: the window
# must hold Burst of the longest abort cycle, or the counter never reaches the burst and the storm never ends:
#   hang after startup:  WatchdogSec 180 + RestartSec 10                        = 190 s, x5 =  950 s (~16 min)
#   hang during startup: startup feed 600 (sd_watchdog.STARTUP_FEED_MAX_S) + 190 = 790 s, x5 = 3950 s (~66 min)
StartLimitIntervalSec=4200
StartLimitBurst=5

[Service]
Type=simple
User=jp
Group=jp
WorkingDirectory=/home/jp/Projects/palace-daemon
ExecStartPre=-/usr/bin/fuser -k 8085/tcp
ExecStartPre=-/bin/rm -f /home/jp/.cache/palace-daemon/daemon-8085.lock
# Wait up to 60s for postgres in Docker container
ExecStartPre=/bin/bash -c 'until docker exec mempalace-db pg_isready -U palace -q 2>/dev/null; do sleep 2; done'
ExecStart=/home/jp/.local/share/palace-daemon/venv/bin/python main.py --palace /srv/mempalace-data/palace
Environment=PALACE_PORT=8085
Environment=PALACE_MAX_CONCURRENCY=4
# CRITICAL: forces in-process path, prevents recursive self-call deadlock.
# See palace-daemon#11.
Environment=PALACE_DAEMON_STRICT=0
# Pin the /search reranker model explicitly so deployed ranking is
# byte-stable across deploys (the code default is this same value, but
# pinning it here + the exact flashrank== in requirements.txt removes the
# "fresh deploy pulls a different model and silently reorders top-5" risk).
# See docs/evals/2026-05-30-retrieval-determinism.md.
Environment=PALACE_RERANK_MODEL=ms-marco-TinyBERT-L-2-v2
EnvironmentFile=/home/jp/.config/palace-daemon/env
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
KillMode=mixed

# Hang watchdog. sd_watchdog.watchdog_loop sends WATCHDOG=1 every
# min(60 s, WatchdogSec/3) only after this process served its own GET /health
# over loopback (the listener, the event loop, the fast executor and the
# handler: the request path that hung on 2026-11-19 for 7 h). No answer within
# the timeout, no ping; after 180 s systemd aborts the daemon and Restart=
# brings it back. A 503 (postgres down) still pings: a restart cannot fix the
# database. During startup sd_watchdog.startup_keepalive feeds it for up to
# 600 s, so a long cold start is not killed. What was missing before was
# WatchdogSec itself: with it set, systemd defaults NotifyAccess to main; it is
# written out here so the sender rule is explicit (tests assert the pings come
# from the main process).
NotifyAccess=main
WatchdogSec=180

# Lower oom_score so userland earlyoom (running on familiar at default
# 10% mem / 10% swap thresholds) doesn't pick the daemon as its
# SIGTERM victim during memory-heavy /graph or /backfill-age calls.
# The daemon's MemoryMax=2G drop-in caps its cgroup; this just keeps
# system-wide pressure from preempting it. -500 displaces the daemon
# below routine python processes without making it completely
# invulnerable. See palace-daemon#154.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
