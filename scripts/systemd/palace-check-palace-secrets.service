[Unit]
Description=palace lane check: strong secret shapes in drawers and entity names, and a miner redaction positive control
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
# A user unit started at boot sees a bare PATH: name the dirs.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Paths and hosts only. Never a secrets file: systemd logs a line it cannot parse in full. The check reads the DSN and
# the daemon API key itself, quietly, from the daemon's env file (PALACE_CHECKS_DSN_FILE).
EnvironmentFile=%h/.config/palace-checks/env
# Report-only until the lane lead has seen the first list of hits; then set PALACE_SECRETS_REDACT=1 in a drop-in.
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/palace_secrets.py
Nice=10
IOSchedulingClass=idle
# The scan (~10 min) and the probe's wait for its mine (PALACE_SECRETS_PROBE_WAIT_S, 20 min) run side by side.
TimeoutStartSec=45min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
ProtectSystem=strict
ReadWritePaths=%h/.local/state/checks %h/.local/state/palace-secrets
PrivateTmp=yes
