[Unit]
Description=palace lane check: postgres statement timeouts in the last hour, by kind
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/pg_timeouts.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
# Reads the database container log through the docker socket (the user is in the docker group) and writes
# only its line under ~/.local/state/checks (checklib). A failed docker call is a fail line, never a zero.
# No secrets file is loaded: thresholds come from PG_TIMEOUTS_* in this unit's environment if ever needed.
