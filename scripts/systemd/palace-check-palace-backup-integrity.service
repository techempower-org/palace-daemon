[Unit]
Description=palace lane check: weekly: the newest palace database dump decompresses whole and ends with pg_dump's closing line
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
# A user unit started at boot sees a bare PATH: name the dirs (systemctl, gzip).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Paths and hosts only (PALACE_BACKUP_DIR). Never a secrets file: systemd logs a line it cannot parse in full.
EnvironmentFile=%h/.config/palace-checks/env
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/palace_backup.py --integrity
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=60min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
ProtectSystem=strict
ReadWritePaths=%h/.local/state/checks
PrivateTmp=yes
