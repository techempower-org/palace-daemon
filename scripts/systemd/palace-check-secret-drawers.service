[Unit]
Description=palace lane check: new secrets or raw secret-shaped text in drawers filed in the last day
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
# A user unit started at boot sees a bare PATH: name the dirs (ssh, systemctl, journalctl).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Paths and hosts only. Never a secrets file: systemd logs a line it cannot parse in full.
EnvironmentFile=%h/.config/palace-checks/env
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/secret_drawers.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
# Read-only filesystem but the line dir (PALACE_CHECKS_DIR must be it). Not on gs-auth: in a
# user unit these work through a user namespace, and ssh then refuses /etc/ssh as "bad owner".
ProtectSystem=strict
ReadWritePaths=%h/.local/state/checks
PrivateTmp=yes
