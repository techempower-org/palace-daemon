[Unit]
Description=tv-trigger — LAN endpoint that toggles the TV output (tv-on / tv-off) for the M5Stick button
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radu
WorkingDirectory=/home/radu/tv-trigger
EnvironmentFile=/home/radu/tv-trigger/.env
ExecStart=/usr/bin/python3 /home/radu/tv-trigger/tv_trigger.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
