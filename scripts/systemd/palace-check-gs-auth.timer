[Unit]
Description=palace lane check: gnome-speaks auth state, refused callers and the boot-PATH fix on each desktop (every 8 h: 07:50, 15:50, 23:50)

[Timer]
OnCalendar=*-*-* 07:50:00
OnCalendar=*-*-* 15:50:00
OnCalendar=*-*-* 23:50:00
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
