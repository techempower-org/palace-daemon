[Unit]
Description=palace lane check: gnome-speaks auth state, refused callers and the boot-PATH fix on each desktop
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
# A user unit started at boot sees a bare PATH: name the dirs (ssh, systemctl, journalctl).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Paths and hosts only. Never a secrets file: systemd logs a line it cannot parse in full.
EnvironmentFile=%h/.config/palace-checks/env
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/gs_auth.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
# No ProtectSystem/PrivateTmp: in a user unit they run in a user namespace, where ssh refuses /etc/ssh as "bad owner".
