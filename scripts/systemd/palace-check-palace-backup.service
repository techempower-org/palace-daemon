[Unit]
Description=palace lane check: last night's palace database dump: age, size, change, unit result
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
# A user unit started at boot sees a bare PATH: name the dirs (systemctl, gzip).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Paths and hosts only (PALACE_BACKUP_DIR). Never a secrets file: systemd logs a line it cannot parse in full.
EnvironmentFile=%h/.config/palace-checks/env
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/palace_backup.py
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
ProtectSystem=strict
ReadWritePaths=%h/.local/state/checks
PrivateTmp=yes
