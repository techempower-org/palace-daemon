[Unit]
Description=palace lane check: redaction needles load and no palace write was refused
Documentation=file://%h/Projects/palace-daemon/docs/CHECKS.md

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/palace-checks/env
ExecStart=%h/.local/share/palace-daemon/venv/bin/python %h/Projects/palace-daemon/scripts/checks/redact_needles.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
# No read-only filesystem here: the probe fetches the needles through bw, which writes its own
# data file under ~/.config/Bitwarden CLI.
